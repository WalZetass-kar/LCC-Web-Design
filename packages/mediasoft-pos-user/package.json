{
  "name": "mediasoft-pos-user",
  "version": "2.0.0",
  "description": "MediaSoft POS - Point of Sale Application for Users",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "Zetass",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "build": "npm run build:electron && npm run build:vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop:windows": "npm run build && electron-builder --win --publish never",
    "build:desktop:linux": "npm run build && electron-builder --linux --publish never",
    "build:desktop:mac": "npm run build && electron-builder --mac --publish never",
    "build:android": "npm run build:vite && npx cap sync android",
    "build:ios": "npm run build:vite && npx cap sync ios",
    "android:release": "npm run build:vite && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run build:vite && npx cap sync android && cd android && ./gradlew bundleRelease",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@mediasoft/shared-lib": "workspace:*",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-table": "^8.17.3",
    "exceljs": "^4.4.0",
    "i18next": "^26.0.10",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.378.0",
    "midtrans-client": "^1.4.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.23.1",
    "react-to-print": "^2.15.1",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.15",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mediasoft.pos.user",
    "productName": "MediaSoft POS",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    }
  }
}
