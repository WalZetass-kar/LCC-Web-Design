{
  "name": "mediasoft-pos-zetass",
  "version": "2.0.0",
  "description": "MediaSoft POS Zetass - Desktop Point of Sale Application",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "Zetass",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && electron .",
    "build": "npm run build:electron && npm run build:vite && electron-builder",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.cjs",
    "build:android": "npm run build:vite && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run build:android && node scripts/build-android.cjs assembleDebug",
    "prepare:android-signing": "node scripts/prepare-android-signing.cjs",
    "android:release": "npm run build:vite && npx cap sync android && npm run prepare:android-signing && node scripts/build-android.cjs assembleRelease",
    "desktop:win": "npm run build:electron && npm run build:vite && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "rebuild:electron": "./node_modules/.bin/electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild:electron"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tanstack/react-table": "^8.17.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.6.0",
    "date-fns": "^3.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.30.10",
    "exceljs": "^4.4.0",
    "i18next": "^26.0.10",
    "jsbarcode": "^3.11.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.378.0",
    "midtrans-client": "^1.4.3",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.23.1",
    "react-to-print": "^2.15.1",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@testing-library/react": "^14.2.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.21.4",
    "electron": "^30.0.6",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.7",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mediasoft.pos.zetass",
    "productName": "MediaSoft POS Zetass v2.0",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "sistem_pos.db",
        "to": "sistem_pos.db"
      },
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaSoft POS Zetass v2.0",
      "deleteAppDataOnUninstall": false
    }
  }
}
