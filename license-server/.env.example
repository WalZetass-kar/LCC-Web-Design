# ===== Server =====
PORT=4000
NODE_ENV=development

# ===== Database =====
# Path file SQLite, default ./data/license.db
DB_PATH=./data/license.db

# ===== JWT =====
# WAJIB diganti di production. Generate dengan: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-me-access-secret-please-change-this
JWT_REFRESH_SECRET=replace-me-refresh-secret-please-change-this
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Default Super Admin (dipakai saat seed) =====
ADMIN_EMAIL=admin@mediasoft.local
ADMIN_PASSWORD="Admin#12345"
ADMIN_NAME=Super Admin

# ===== CORS =====
# Pisahkan dengan koma, contoh: http://localhost:5173,https://app.kamu.com
CORS_ORIGINS=*

# ===== Branding popup default =====
APP_BILLING_URL=https://wa.me/628123456789
APP_WHATSAPP=628123456789
