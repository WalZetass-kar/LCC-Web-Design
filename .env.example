# MediaSoft POS - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# MIDTRANS PAYMENT GATEWAY
# ============================================================================
# Get your keys from: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id_here
MIDTRANS_IS_PRODUCTION=false

# ============================================================================
# AWS S3 CLOUD STORAGE
# ============================================================================
# Get your credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=mediasoft-pos-backups

# ============================================================================
# GOOGLE CLOUD STORAGE (Alternative to AWS S3)
# ============================================================================
# Get your credentials from: https://console.cloud.google.com/
GCS_PROJECT_ID=your_project_id_here
GCS_KEY_FILE=./gcs-service-account-key.json
GCS_BUCKET_NAME=mediasoft-pos-backups

# ============================================================================
# API SERVER (for Mobile App)
# ============================================================================
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=change_this_to_random_32_character_string
JWT_EXPIRY=7d
API_BASE_URL=http://localhost:3000

# ============================================================================
# FIREBASE (for Mobile Push Notifications)
# ============================================================================
# Get your credentials from: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ============================================================================
# ENCRYPTION
# ============================================================================
# Generate a random 32-character key for backup encryption
BACKUP_ENCRYPTION_KEY=change_this_to_random_32_char_key

# ============================================================================
# CLOUD PROVIDER SELECTION
# ============================================================================
# Options: S3, GCS, AZURE
CLOUD_PROVIDER=S3

# ============================================================================
# BACKUP SETTINGS
# ============================================================================
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# ============================================================================
# SYNC SETTINGS
# ============================================================================
SYNC_ENABLED=true
SYNC_INTERVAL=300000 # 5 minutes in milliseconds
SYNC_CONFLICT_RESOLUTION=server_wins # Options: server_wins, client_wins, manual

# ============================================================================
# DEVELOPMENT
# ============================================================================
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info
